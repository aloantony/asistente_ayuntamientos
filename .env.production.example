# Plantilla del entorno de PRODUCCIÓN. Ver docs/despliegue.md y ADR-031/031.
#
# Cópiala al servidor como /opt/anacleto/.env.production, con dueño root:root y
# permisos 0600. NUNCA se versiona: .gitignore la excluye.
#
# Genera cada secreto en el servidor:
#   SECRET_KEY:            openssl rand -base64 48
#   POSTGRES_PASSWORD:     openssl rand -base64 32
#   BOOTSTRAP_ADMIN_TOKEN: openssl rand -base64 32
#
# El backend se NIEGA A ARRANCAR en producción si SECRET_KEY es el valor de
# ejemplo o mide menos de 32 caracteres, si CORS_ALLOWED_ORIGINS no es https, o
# si ALLOWED_HOSTS es "*". Es intencionado: un .env de desarrollo copiado por
# descuido debe fallar de forma ruidosa, no silenciosa.

# --- Identidad del despliegue ------------------------------------------------
# Hostname CANÓNICO, sin esquema ni barra final. Lo usan Caddy, el build del
# frontend, CORS y TrustedHostMiddleware. Aquí el canónico lleva www.
PUBLIC_HOSTNAME=www.miconcejo.es
# Dominio a secas: Caddy lo sirve sólo para redirigir al canónico. También tiene
# que resolver a este servidor o no podrá emitir su certificado.
APEX_HOSTNAME=miconcejo.es
# Correo para los avisos de caducidad de Let's Encrypt.
ACME_EMAIL=avisos@miconcejo.es

ENVIRONMENT=production
APP_NAME=Anacleto
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Seguridad ---------------------------------------------------------------
SECRET_KEY=GENERA-UNO-CON-openssl-rand-base64-48
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Debe coincidir con PUBLIC_HOSTNAME. Solo https en producción.
CORS_ALLOWED_ORIGINS=https://www.miconcejo.es
# Hostnames que el backend acepta en la cabecera Host. Sin "*".
# Sólo el canónico: al dominio a secas lo redirige Caddy y nunca llega al backend.
ALLOWED_HOSTS=www.miconcejo.es
# El proxy publica la API bajo /api y elimina el prefijo antes de reenviar.
API_ROOT_PATH=/api

# Se usa UNA vez para crear el primer superusuario y después se BORRA de este
# fichero, reiniciando el backend: el endpoint pasa a 503. Ver docs/despliegue.md.
BOOTSTRAP_ADMIN_TOKEN=GENERA-UNO-Y-BORRALO-TRAS-USARLO

# --- Límites de tasa ---------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_IP_RATE_LIMIT_ATTEMPTS=50
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=300
BOOTSTRAP_ADMIN_RATE_LIMIT_ATTEMPTS=5
BOOTSTRAP_ADMIN_RATE_LIMIT_WINDOW_SECONDS=3600
ASSISTANT_RATE_LIMIT_ATTEMPTS=30
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=300
SPEECH_RATE_LIMIT_ATTEMPTS=40
SPEECH_RATE_LIMIT_WINDOW_SECONDS=300
UPLOAD_RATE_LIMIT_ATTEMPTS=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
ORDINANCE_IMPORT_RATE_LIMIT_ATTEMPTS=10
ORDINANCE_IMPORT_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Datos -------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=GENERA-UNA-CON-openssl-rand-base64-32
# Los nombres de host son los de la red interna de Compose, no 127.0.0.1: en
# producción no se usa network_mode: host.
DATABASE_URL=postgresql+psycopg://app:LA-MISMA-CONTRASENA@postgres:5432/app
REDIS_URL=redis://redis:6379/0

DOCUMENT_STORAGE_ROOT=/var/lib/asistente_ayuntamientos/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
MUNICIPAL_SHIELD_MAX_UPLOAD_BYTES=2097152
MUNICIPAL_WEATHER_TIMEOUT_SECONDS=5
MUNICIPAL_WEATHER_CACHE_SECONDS=1800

# --- Asistente ---------------------------------------------------------------
# En producción solo runtimes con contrato firmado: anthropic u openai_responses.
# codex_subscription está PROHIBIDO y el backend se niega a arrancar con él
# (ADR-024). Dejar el runtime sin clave hace que el asistente responda 503 por
# diseño: el resto de la aplicación funciona.
ASSISTANT_RUNTIME=anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-4-8
ASSISTANT_MAX_TOKENS=16000
ASSISTANT_MAX_TOOL_ITERATIONS=8
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_TURN_TIMEOUT_SECONDS=120
ASSISTANT_GATEWAY_TIMEOUT_SECONDS=30
ASSISTANT_HISTORY_MAX_MESSAGES=40

# Alternativa con residencia UE aprobada:
# ASSISTANT_RUNTIME=openai_responses
# OPENAI_API_KEY=
# OPENAI_RESPONSES_BASE_URL=https://eu.api.openai.com/v1
# OPENAI_RESPONSES_MODEL=gpt-5.6

# --- Voz ---------------------------------------------------------------------
# Desactivadas hasta cerrar contrato y región con cada proveedor. Si se activa
# la voz realtime, hay que añadir https://api.openai.com a connect-src en la CSP
# del Caddyfile o el navegador bloqueará la conexión.
ASSISTANT_REALTIME_ENABLED=false
SPEECH_TRANSCRIPTION_RUNTIME=disabled
SPEECH_TRANSCRIPTION_TIMEOUT_SECONDS=30
SPEECH_TRANSCODE_TIMEOUT_SECONDS=20
SPEECH_SYNTHESIS_RUNTIME=disabled

# --- Búsqueda web ------------------------------------------------------------
WEB_SEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_RIGHTS_CONFIRMED=false

# --- Integraciones desactivadas ----------------------------------------------
# Telegram solo se activa con secreto de webhook: sin él la ruta devuelve 503
# a propósito (ADR-032).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
HERMES_AGENT_REAL_DATA_ALLOWED=false
CODEX_SUBSCRIPTION_ENABLED=false
CODEX_SUBSCRIPTION_REAL_DATA_ALLOWED=false

# --- Ordenanzas --------------------------------------------------------------
ORDINANCE_IMPORT_MAX_FETCH_BYTES=15728640
ORDINANCE_IMPORT_SEARCH_LIMIT=5
ORDINANCE_IMPORT_MAX_CHUNKS=200
ORDINANCE_CHUNK_CHARS=1400
EMBEDDINGS_RUNTIME=local_hash
EMBEDDINGS_MODEL=local-hash-384
EMBEDDINGS_DIMENSIONS=384

# --- Copias de seguridad -----------------------------------------------------
# Directorio del servidor donde escribe ops/backup.sh (fuera del repo).
BACKUP_ROOT=/var/backups/anacleto
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
# Retención de la traza de seguridad. Contiene IP y correo intentado, que son
# datos personales: ver docs/proteccion-datos.md.
SECURITY_EVENT_RETENTION_DAYS=90

# Groq is opt-in; no automatic fallback to another provider.
# ASSISTANT_RUNTIME=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
