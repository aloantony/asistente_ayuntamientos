APP_NAME=Asistente Ayuntamientos
APP_VERSION=0.1.0
# Fuera de development/test la cookie de sesión se emite con el flag Secure
# (solo viaja por HTTPS). En producción define ENVIRONMENT=production y sirve
# la aplicación detrás de TLS; si se olvida, la cookie viajaría sin Secure.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=change-this-secret-key-in-real-environments
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-token
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCUMENT_STORAGE_ROOT=/var/lib/asistente_ayuntamientos/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
REFERENCE_STORAGE_ROOT=/var/lib/asistente_ayuntamientos/reference-artifacts
# Scratch independiente: nunca se sirve ni se incluye en recuperación. Los
# brutos que solo pueden procesarse transitoriamente se borran al terminar y
# cualquier parcial huérfano se purga al abrir una nueva adquisición.
REFERENCE_TRANSIENT_ROOT=/var/lib/asistente_ayuntamientos/reference-transient
# El worker aplica ambos limites antes de publicar blobs CAS. La cuota es del
# arbol completo y el minimo libre protege el resto del servidor.
REFERENCE_BLOB_MAX_BYTES=274877906944
REFERENCE_STORAGE_QUOTA_BYTES=1099511627776
REFERENCE_STORAGE_MIN_FREE_BYTES=21474836480
# Solo los ficheros parciales sin lock en staging pueden purgarse; los blobs
# publicados y su historial quedan retenidos indefinidamente.
REFERENCE_STAGING_RETENTION_SECONDS=86400
# Private group shared only by reference-data writers and GeoServer readers.
REFERENCE_STORAGE_GID=2000
# Scheduler/worker del espejo local. La cola durable vive en PostgreSQL; el
# heartbeat usa sesiones nuevas y debe ser holgadamente menor que el lease.
REFERENCE_MIRROR_SCHEDULER_POLL_SECONDS=15
# Consulta el estado durable cada 5 minutos; la descarga condicional del
# settings.json solo vence una vez al día y nunca autoaplica cambios.
REFERENCE_CATALOG_WATCHER_POLL_SECONDS=300
REFERENCE_MIRROR_WORKER_POLL_SECONDS=2
REFERENCE_MIRROR_ENQUEUE_LIMIT=100
REFERENCE_MIRROR_LEASE_SECONDS=600
REFERENCE_MIRROR_HEARTBEAT_SECONDS=60
REFERENCE_TILE_ARCHIVE_MAX_BYTES=274877906944
REFERENCE_TILE_MAX_COUNT=10000000
REFERENCE_TILE_CONCURRENCY=4
REFERENCE_TILE_BATCH_SIZE=64
REFERENCE_TILE_CHANGE_CHECK_SAMPLES=16
REFERENCE_GEO_MAX_SOURCE_BYTES=8589934592
REFERENCE_GEO_TIMEOUT_SECONDS=3600
# Fail-closed: serving SIUR/reference requests from upstream WMS is disabled.
# Set true only as an explicit operational exception while local mirrors catch up.
REFERENCE_REMOTE_PROXY_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Render cartografico local. GeoServer solo se publica en loopback. Compose
# elimina estas credenciales del backend web. GeoServer no publica su 8080:
# el puerto siguiente pertenece al gateway fail-closed, que revalida store y
# cuota antes de cada request; publicacion tambien pasa por el gateway.
GEOSERVER_PORT=8081
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-this-geoserver-admin-password
LOCAL_GEOSERVER_BASE_URL=http://127.0.0.1:8081/geoserver
LOCAL_GEOSERVER_WORKSPACE=siur
LOCAL_GEOSERVER_TIMEOUT_SECONDS=8
# GeoWebCache no limita disco por defecto. El comando operativo mide bloques
# fisicos e inodos sobre un unico filesystem sin seguir enlaces, aplica al
# crecimiento logico restante un margen fisico minimo del 125 %, conserva este
# suelo libre y verifica por GET tras PUT. Antes de la cuota crea/revalida por
# XML el FileBlobStore exacto `/var/lib/geowebcache`; cualquier blobstore extra
# bloquea el arranque. El one-shot `gwc-bootstrap` debe terminar con exito y el
# gateway debe estar sano antes de iniciar API, frontend o workers; despues el
# gateway repite la verificacion en cada request. Un block-size restaurado solo
# se migra si es la unica diferencia y v3 esta vacio. Solo las teselas de v3 son
# reconstruibles; GEOWEBCACHE_CACHE_DIR apunta a configuracion respaldada en
# `geoserver_data`, no a teselas. No reutilizar ni borrar el volumen v2.
GEOWEBCACHE_DISK_QUOTA_GIB=20
GEOWEBCACHE_DISK_QUOTA_MIN_FREE_GIB=5
GEOWEBCACHE_DISK_QUOTA_CLEANUP_SECONDS=60
GEOWEBCACHE_DISK_QUOTA_POLICY=LRU
# Conexion que GeoServer (no el navegador) usa para publicar tablas PostGIS.
# Se declara aparte de DATABASE_URL para mantener las credenciales de
# publicacion como SecretStr, fuera del backend web, representaciones y logs.
LOCAL_GEOSERVER_POSTGIS_HOST=postgres
LOCAL_GEOSERVER_POSTGIS_PORT=5432
LOCAL_GEOSERVER_POSTGIS_DATABASE=app
LOCAL_GEOSERVER_POSTGIS_USER=app
LOCAL_GEOSERVER_POSTGIS_PASSWORD=app
# Asistente conversacional (IA). Runtimes:
# anthropic | hermes_agent | openai_responses | codex_subscription (solo desarrollo)
ASSISTANT_RUNTIME=anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-4-8
# OpenAI Responses usa una clave de proyecto de la API; una suscripcion de ChatGPT
# no concede acceso a la API ni sustituye su facturacion. Para proyectos con
# residencia regional aprobada se puede usar https://eu.api.openai.com/v1.
OPENAI_API_KEY=
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_MODEL=gpt-5.6
OPENAI_RESPONSES_REASONING_EFFORT=medium
OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=25000
# Puente local oficial a una suscripcion ChatGPT mediante `codex app-server`.
# NO es un runtime de produccion, no usa OPENAI_API_KEY y se rechaza si
# ENVIRONMENT no es exactamente development. Requiere el binario `codex` en el
# mismo entorno que el backend y un CODEX_HOME exclusivo con permisos 0700.
# No reutilices ni copies ~/.codex; autentica el directorio dedicado:
#   install -d -m 700 "$HOME/.codex-asistente-ayuntamientos"
#   HOME="$HOME/.codex-asistente-ayuntamientos" \
#     CODEX_HOME="$HOME/.codex-asistente-ayuntamientos" codex login
# Ambos opt-in son obligatorios para arrancar este runtime experimental. El
# segundo reconoce que el contenido puede salir hacia la cuenta ChatGPT.
CODEX_SUBSCRIPTION_ENABLED=false
CODEX_SUBSCRIPTION_REAL_DATA_ALLOWED=false
CODEX_SUBSCRIPTION_COMMAND=codex
CODEX_SUBSCRIPTION_HOME=~/.codex-asistente-ayuntamientos
# Solo para docker-compose.codex-subscription.yml: directorio vendor de la
# distribución Codex de esta plataforma, que contiene bin/codex y sus recursos.
CODEX_SUBSCRIPTION_HOST_VENDOR_PATH=
CODEX_SUBSCRIPTION_CONTAINER_UID=1000
CODEX_SUBSCRIPTION_CONTAINER_GID=1000
# Vacio usa el modelo por defecto disponible en la suscripcion.
CODEX_SUBSCRIPTION_MODEL=
CODEX_SUBSCRIPTION_REASONING_EFFORT=medium
CODEX_SUBSCRIPTION_SESSION_TTL_SECONDS=180
CODEX_SUBSCRIPTION_MAX_SESSIONS=4
CODEX_SUBSCRIPTION_HEALTH_TIMEOUT_SECONDS=3
ASSISTANT_MAX_TOKENS=16000
ASSISTANT_MAX_TOOL_ITERATIONS=8
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_TURN_TIMEOUT_SECONDS=120
ASSISTANT_GATEWAY_TIMEOUT_SECONDS=30
ASSISTANT_HISTORY_MAX_MESSAGES=40
ASSISTANT_MAX_ATTACHMENTS_PER_MESSAGE=5
ASSISTANT_ATTACHMENT_MAX_CONTEXT_CHARS=6000
ASSISTANT_ATTACHMENT_TOTAL_CONTEXT_CHARS=12000
ASSISTANT_ATTACHMENT_MAX_EXTRACT_BYTES=5242880
ASSISTANT_ATTACHMENT_TEXT_MAX_CONCURRENCY=4
# Hermes Agent API Server. En ~/.hermes/.env del servicio Hermes:
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8642
# API_SERVER_KEY=<mismo valor que HERMES_AGENT_API_KEY>
# El backend usa network_mode: host en desarrollo para alcanzar Hermes en loopback.
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642/v1
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
# Opt-in técnico: solo true tras verificar que el API Server principal no
# conserva ningún toolset nativo ni puede ejecutar herramientas fuera del
# catálogo enviado por este backend. Sin esta atestación Hermes queda 503.
HERMES_AGENT_NATIVE_TOOLS_DISABLED_CONFIRMED=false
# En production no se habilita con datos reales salvo que la revisión legal/técnica esté cerrada.
HERMES_AGENT_REAL_DATA_ALLOWED=false
HERMES_AGENT_TIMEOUT_SECONDS=120
HERMES_AGENT_HEALTH_TIMEOUT_SECONDS=3
# Búsqueda web controlada. Proveedores: brave | hermes | disabled.
# Brave es la opción principal: la clave permanece en backend y solo se envía
# la consulta pública explícita, siempre detrás de RBAC y auditoría.
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_TIMEOUT_SECONDS=15
BRAVE_SEARCH_COUNTRY=ES
BRAVE_SEARCH_LANGUAGE=es
BRAVE_SEARCH_UI_LANGUAGE=es-ES
# Debe seguir false en cualquier entorno hasta confirmar DPA/retención y que
# el plan de Brave concede derechos para almacenar los resultados auditados.
BRAVE_SEARCH_STORAGE_RIGHTS_CONFIRMED=false
# Lector experimental de HTML/texto, independiente de web_search y apagado por
# defecto. No admite PDF ni Realtime. El timeout incluye arranque del proceso,
# DNS, conexión/TLS, cabeceras, redirects, cuerpo y extracción; la limpieza del
# proceso puede añadir como máximo 0,55 s. La concurrencia se admite con
# fail-fast y conserva el slot hasta recolectar cualquier arranque tardío.
ASSISTANT_WEB_READER_ENABLED=false
WEB_PAGE_TIMEOUT_SECONDS=10
WEB_PAGE_DNS_TIMEOUT_SECONDS=3
WEB_PAGE_MAX_CONCURRENT_READERS=4
WEB_PAGE_MAX_RESPONSE_BYTES=2097152
WEB_PAGE_MAX_REDIRECTS=3
WEB_PAGE_MAX_TEXT_CHARS=12000
# Compatibilidad opcional: instancia Hermes separada con solo el toolset web.
# Solo se utiliza cuando WEB_SEARCH_PROVIDER=hermes; nunca es fallback de Brave.
HERMES_WEB_BASE_URL=http://127.0.0.1:8643/v1
HERMES_WEB_API_KEY=
HERMES_WEB_MODEL=hermes-agent
HERMES_WEB_TIMEOUT_SECONDS=60
# Voz realtime con OpenAI. El navegador envia audio directamente al proveedor
# mediante WebRTC y una credencial efimera emitida por el backend. Mantenlo
# desactivado con datos reales hasta aprobar contractualmente al proveedor.
# Siempre requiere OPENAI_API_KEY con facturacion API independiente; una
# suscripcion ChatGPT/Codex no incluye Realtime ni sirve como credencial.
ASSISTANT_REALTIME_ENABLED=false
ASSISTANT_REALTIME_MODEL=gpt-realtime-2.1
ASSISTANT_REALTIME_VOICE=marin
ASSISTANT_REALTIME_URL=https://api.openai.com/v1/realtime/calls
ASSISTANT_REALTIME_CLIENT_SECRET_URL=https://api.openai.com/v1/realtime/client_secrets
ASSISTANT_REALTIME_TIMEOUT_SECONDS=20
ASSISTANT_REALTIME_LANGUAGE_CODE=es
ASSISTANT_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
ASSISTANT_REALTIME_TRANSCRIPTION_DELAY=low
ASSISTANT_REALTIME_VAD_THRESHOLD=0.5
ASSISTANT_REALTIME_VAD_PREFIX_PADDING_MS=300
ASSISTANT_REALTIME_VAD_SILENCE_DURATION_MS=500
# Ordenanzas: importador, revisión y búsqueda semántica
ORDINANCE_IMPORT_MAX_FETCH_BYTES=15728640
ORDINANCE_IMPORT_SEARCH_LIMIT=5
ORDINANCE_IMPORT_MAX_CHUNKS=200
ORDINANCE_CHUNK_CHARS=1400
EMBEDDINGS_RUNTIME=local_hash
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=local-hash-384
EMBEDDINGS_DIMENSIONS=384
EMBEDDINGS_TIMEOUT_SECONDS=60
EMBEDDINGS_MAX_CONCURRENT_WORKERS=4
# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE_TTL_SECONDS=600
# Voz (ADR-021): STT y TTS en nube gestionada; ambos deshabilitados por defecto.
# El audio del usuario y el texto de respuesta salen SOLO por app/assistant/speech.py.
# STT (transcripción). Runtimes: disabled | nvidia_nim
SPEECH_TRANSCRIPTION_RUNTIME=disabled
SPEECH_TRANSCRIPTION_LANGUAGE_CODE=es-ES
SPEECH_TRANSCRIPTION_MAX_BYTES=20971520
NVIDIA_API_KEY=
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
# Function-id del Whisper alojado en NVIDIA API (build.nvidia.com):
NVIDIA_WHISPER_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# TTS (síntesis). Runtimes: disabled | azure
# Recurso "Speech" de Azure AI Services. Suscripción Azure for Students = solo
# desarrollo/evaluación; producción requiere suscripción pay-as-you-go propia.
SPEECH_SYNTHESIS_RUNTIME=disabled
SPEECH_SYNTHESIS_VOICE=es-ES-DarioNeural
SPEECH_SYNTHESIS_LANGUAGE_CODE=es-ES
SPEECH_SYNTHESIS_OUTPUT_FORMAT=audio-48khz-96kbitrate-mono-mp3
SPEECH_SYNTHESIS_RATE=+12%
SPEECH_SYNTHESIS_MAX_CHARS=3000
SPEECH_SYNTHESIS_TIMEOUT_SECONDS=30
AZURE_SPEECH_KEY=
# Región del recurso Speech. Debe ser una región UE admitida por la política de la
# suscripción (p. ej. northeurope, swedencentral, francecentral, germanywestcentral).
AZURE_SPEECH_REGION=northeurope
