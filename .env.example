APP_NAME=Asistente Ayuntamientos
APP_VERSION=0.1.0
# Fuera de development/test la cookie de sesión se emite con el flag Secure
# (solo viaja por HTTPS). En producción define ENVIRONMENT=production y sirve
# la aplicación detrás de TLS; si se olvida, la cookie viajaría sin Secure.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=change-this-secret-key-in-real-environments
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-token
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCUMENT_STORAGE_ROOT=/var/lib/asistente_ayuntamientos/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Asistente conversacional (IA). Runtimes: anthropic | hermes_agent
ASSISTANT_RUNTIME=anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-4-8
ASSISTANT_MAX_TOKENS=16000
ASSISTANT_MAX_TOOL_ITERATIONS=8
# Planner/orquestador semántico. En el runtime Hermes es obligatorio para que
# el asistente no caiga en shortcuts rígidos; el backend sigue ejecutando y
# auditando todas las acciones de producto.
ASSISTANT_PLANNER_RUNTIME=hermes_agent
ASSISTANT_PLANNER_MODEL=hermes-agent
ASSISTANT_PLANNER_MAX_TOKENS=256
ASSISTANT_PLANNER_TIMEOUT_SECONDS=30
# Hermes Agent API Server. En ~/.hermes/.env del servicio Hermes:
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8642
# API_SERVER_KEY=<mismo valor que HERMES_AGENT_API_KEY>
# El backend usa network_mode: host en desarrollo para alcanzar Hermes en loopback.
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642/v1
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
# En production no se habilita con datos reales salvo que la revisión legal/técnica esté cerrada.
HERMES_AGENT_REAL_DATA_ALLOWED=false
HERMES_AGENT_TIMEOUT_SECONDS=120
HERMES_AGENT_HEALTH_TIMEOUT_SECONDS=3
# Hermes Web controlado. Instancia separada de Hermes con api_server en 8643
# y solo el toolset web habilitado. Lo usa la herramienta backend web_search,
# siempre detrás de RBAC y auditoría de la aplicación.
HERMES_WEB_BASE_URL=http://127.0.0.1:8643/v1
HERMES_WEB_API_KEY=
HERMES_WEB_MODEL=hermes-agent
HERMES_WEB_TIMEOUT_SECONDS=60
# Ordenanzas: importador, revisión y búsqueda semántica
ORDINANCE_IMPORT_MAX_FETCH_BYTES=15728640
ORDINANCE_IMPORT_SEARCH_LIMIT=5
ORDINANCE_IMPORT_MAX_CHUNKS=200
ORDINANCE_CHUNK_CHARS=1400
EMBEDDINGS_RUNTIME=local_hash
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=local-hash-384
EMBEDDINGS_DIMENSIONS=384
EMBEDDINGS_TIMEOUT_SECONDS=60
# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE_TTL_SECONDS=600
